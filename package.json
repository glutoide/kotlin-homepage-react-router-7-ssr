    "@rescui/card": "0.15.1",
    "@rescui/switcher": "0.14.1",
    "@rescui/tab-list": "0.19.1",
    "@rescui/typography": "0.28.1",
    "@rescui/ui-contexts": "0.7.0",
    "body-scroll-lock": "4.0.0-beta.0",
    "classnames": "2.5.1",
    "highlight.js": "10.5.0",
    "isbot": "5.1.32",
