FROM node:16-bullseye

ENV DEBIAN_FRONTEND=noninteractive

# The pinned reference depends on archived Bullseye packages that are no longer
# guaranteed to exist on live Debian mirrors. This changes only the build
# environment; the reference source and frontend lockfiles remain untouched.
RUN printf 'deb http://archive.debian.org/debian bullseye main\n' > /etc/apt/sources.list \
    && rm -f /etc/apt/sources.list.d/*

RUN apt-get -o Acquire::Check-Valid-Until=false -o Acquire::Check-Date=false update \
    && apt-get install -y --no-install-recommends \
       build-essential \
       python3 \
       python3-dev \
       python3-pip \
       ruby \
    && rm -rf /var/lib/apt/lists/*

RUN gem install kramdown -v 1.14.0 --no-document

COPY reference-project/requirements.txt /tmp/reference-requirements.txt
RUN python3 -m pip install --no-cache-dir \
      "Jinja2==2.11.3" \
      "MarkupSafe==2.0.1" \
      "Werkzeug==0.16.1" \
      "itsdangerous==1.1.0" \
      "click==7.1.2" \
    && python3 -m pip install --no-cache-dir -r /tmp/reference-requirements.txt

COPY reference-project/package.json reference-project/yarn.lock /src/
WORKDIR /src
RUN corepack enable \
    && corepack prepare yarn@1.22.22 --activate \
    && yarn install --frozen-lockfile

EXPOSE 8080
ENTRYPOINT ["python3", "/src/kotlin-website.py"]
